<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Everything here is load-bearing. Taken in order:

      INTERNET                     — the LAN counts as "internet" to Android.
      ACCESS_NETWORK_STATE         — so the service can tell wifi loss from host failure.
      POST_NOTIFICATIONS           — Android 13+. Without it there is no foreground
                                     service notification, and so no foreground service.
      FOREGROUND_SERVICE           — the service itself.
      FOREGROUND_SERVICE_SPECIAL_  — Android 14+ makes you name the type. Not dataSync:
        USE                          Android 15 stops a dataSync service after six hours
                                     in any twenty-four and will not start one at boot,
                                     and a pager that goes deaf mid-shift or after a
                                     restart is worse than none. specialUse has neither
                                     limit. The app is sideloaded, so there is no Play
                                     review of the declared use, only the OS.
      WAKE_LOCK                    — keeps the CPU alive long enough to raise the alarm
                                     when a job lands at 3am with the screen off.
      VIBRATE                      — felt before it is heard, next to a running set.
      RECEIVE_BOOT_COMPLETED       — phones get restarted. The service must come back by
                                     itself, or the department silently loses a listener.
      REQUEST_IGNORE_BATTERY_      — the single most important one in Nigeria. Without it
        OPTIMIZATIONS                Doze stops the service within hours.
      USE_FULL_SCREEN_INTENT       — a P1 wakes the lock screen rather than waiting to be
                                     pulled down.
      SCHEDULE_EXACT_ALARM         — when the system kills the service, it is brought back
                                     by an alarm a few seconds later; without this the
                                     alarm is inexact and Doze can push it out by minutes.
                                     Not granted by default on Android 14+, so the app
                                     asks once.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- The QR scan that pairs the phone. Nothing else uses the camera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="FacilityFlow Alerts"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Declared explicitly so the type is attached on Android 14+. See
             FOREGROUND_SERVICE_SPECIAL_USE above for why it is not dataSync. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds a connection to the property's maintenance server so an urgent job, a supervisor ringing this person, or an emergency alert rings the phone the moment it happens, with the screen off." />
        </service>

        <!-- The boot/package-replaced receiver comes from flutter_foreground_task's own
             manifest; redeclaring it here with different attributes breaks the merge. -->

        <!-- The lock-screen buttons — Accept, I am here, I have seen this. They are sent
             without opening the app (showsUserInterface: false), which flutter_local_
             notifications delivers as a broadcast to this receiver. Its own manifest does
             not declare it; without this line every press is dropped and the alarm can
             only be stopped by unlocking the phone and opening the app. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <!-- url_launcher: "Open the full system" opens the host in a browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
